<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.backstage" path="/org/gnome/shell/extensions/backstage/">
    <key name="toggle-island" type="as">
      <default><![CDATA[['<Super><Alt>n']]]></default>
      <summary>Open or close the island</summary>
    </key>
    <key name="ask-now" type="as">
      <default><![CDATA[['<Super>a']]]></default>
      <summary>Answer the latest question, using a screenshot</summary>
    </key>
    <key name="prompter-back" type="as">
      <default><![CDATA[['<Super><Alt>Up']]]></default>
      <summary>Move the teleprompter one line back</summary>
    </key>
    <key name="prompter-next" type="as">
      <default><![CDATA[['<Super><Alt>Down']]]></default>
      <summary>Move the teleprompter one line forward</summary>
    </key>
  </schema>
</schemalist>
